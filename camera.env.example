# 复制为 camera.env 后按现场修改（run_camera.sh 会自动 source）
GIGE_IF=enp3s0
GIGE_HOST_IP=192.168.5.100
GIGE_PREFIX=24

# 孔板规模（自动推断失败时使用）
GRID_ROWS=6
GRID_COLS=4
# AUTO_DETECT_GRID 在 rack_config.py 里改 True/False

# 相机选择（插 USB 工业相机时用 usb，跳过网口）
# CAM_DEVICE_TYPE=usb
# CAM_SERIAL_NUMBER=
# CAM_BACKEND=hik          # hik | opencv
# CAM_UVC_INDEX=0          # CAM_BACKEND=opencv 时 /dev/videoN

# 可选：默认曝光
# EXPOSURE=180000
# GAIN=16
# BINNING=2
